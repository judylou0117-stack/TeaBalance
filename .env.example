# Server-side only. Never put real keys or model values in client code, and never commit .env.local.
# `mock` is the safe default: no request is sent to OpenRouter.
TEA_BALANCE_AI_MODE=mock

# Set all of the following only when you intentionally enable `live` mode.
OPENROUTER_API_KEY=
# Optional common model ID for both modules. Leave blank until you have chosen a verified model.
OPENROUTER_MODEL=
# Optional module-specific model IDs; they take precedence over the common model.
OPENROUTER_MODEL_A=
OPENROUTER_MODEL_B=
