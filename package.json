{
  "name": "tea-balance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "rules:import": "python scripts/import-rules.py",
    "knowledge:import": "python scripts/import-knowledge.py",
    "test:rules": "node --experimental-strip-types --test tests/rules.test.ts",
    "test:api": "node --experimental-strip-types --test tests/analyze-api.test.ts",
    "test:knowledge": "node --experimental-strip-types --test tests/knowledge-retrieval.test.ts",
    "test:explanation": "node --experimental-strip-types --test tests/explanation-service.test.ts",
    "test:conversation": "node --experimental-strip-types --test tests/conversation-module.test.ts",
    "test:conversation-api": "node --experimental-strip-types --test tests/conversation-api.test.ts",
    "test:conversation-errors": "node --experimental-strip-types --test tests/conversation-error-handling.test.ts",
    "test:openrouter": "node --experimental-strip-types --test tests/openrouter-adapter.test.ts",
    "test:i18n": "node --experimental-strip-types --test tests/multilingual.test.ts",
    "test:session": "node --experimental-strip-types --test tests/session-version.test.ts",
    "test:presentation": "node --experimental-strip-types --test tests/result-presentation.test.ts",
    "test:localization": "node --experimental-strip-types --test tests/result-localization.test.ts",
    "test:visuals": "node --experimental-strip-types --test tests/tea-images.test.ts tests/constitution-leaves.test.ts",
    "test:all": "node --experimental-strip-types --test tests/rules.test.ts tests/analyze-api.test.ts tests/knowledge-retrieval.test.ts tests/explanation-service.test.ts tests/conversation-module.test.ts tests/conversation-api.test.ts tests/conversation-error-handling.test.ts tests/openrouter-adapter.test.ts tests/multilingual.test.ts tests/session-version.test.ts tests/result-presentation.test.ts tests/result-localization.test.ts tests/tea-images.test.ts tests/constitution-leaves.test.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
